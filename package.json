{
  "name": "dark-project-studio",
  "productName": "Dark Project Studio",
  "private": true,
  "version": "2.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "build:exe": "npm run build && electron-builder --win nsis portable",
    "build:desktop": "npm run build && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "eu.darkproject.studio",
    "productName": "Dark Project Studio",
    "copyright": "Copyright © 2026 Dark Project",
    "publish": [
      {
        "provider": "github",
        "owner": "TheMich157",
        "repo": "DarkProjectReworked"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png",
      "publisherName": "Dark Project Studio",
      "legalTrademarks": "Dark Project Studio",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "Dark_Project_Studio_v${version}_Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dark Project Studio",
      "publisherName": "Dark Project Studio",
      "differentialPackage": true,
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "Dark_Project_Studio_v${version}_Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  }
}